<text top="397" left="117" width="193" height="26" font="0"><b>SUMMER IS HERE!</b></text>
<text top="402" left="424" width="88" height="20" font="1"><b>LESSON 1</b></text>
<text top="400" left="117" width="22" height="20" font="2">M </text>
<text top="404" left="139" width="75" height="18" font="3"><i><b>ACTIVITY</b></i></text>
<text top="401" left="214" width="5" height="21" font="4"> </text>
